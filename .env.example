# ============================================================
# Environment variables — set these in Vercel → Settings →
# Environment Variables. Never commit real values.
#
# All of these belong to RESEAL CANADA's own accounts. They must not
# be shared with any other business — deposits land in whichever
# account these keys belong to.
# ============================================================

# --- Job storage (required) -------------------------------------------------
# Auto-injected when you connect Upstash Redis in Vercel → Storage.
# The code accepts either naming scheme.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Email (required) -------------------------------------------------------
# Resend. The sending domain must be verified for resealcanada.ca.
RESEND_API_KEY=
RESEND_FROM=Reseal Canada <bookings@resealcanada.ca>

# --- Card payments (required for card deposits) -----------------------------
# The API token needs General=Read AND refund/void permission.
HELCIM_API_TOKEN=
HELCIM_WEBHOOK_VERIFIER_TOKEN=
# Webhook URL to register in Helcim:
#   https://resealcanada.ca/api/card-webhook
#   (it must NOT contain the word "helcim" — Helcim rejects those URLs)

# --- PayPal (required for PayPal deposits) ----------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Set PAYPAL_ENV=live only after a successful sandbox test.

# --- Signing (required) -----------------------------------------------------
# Secures the one-click job-board and status links in alert emails.
# Any long random string. Changing it invalidates links already sent.
APP_SECRET=

# --- Owner SMS (optional) ---------------------------------------------------
# Replaces the old Firebase function's Twilio call. Leave blank to
# disable texts; everything else still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM= is an alternative to the messaging service SID
OWNER_SMS_TO=+16477065123

# --- Site (optional) --------------------------------------------------------
# Used to build absolute links in emails. Defaults to https://resealcanada.ca
SITE_URL=https://resealcanada.ca
